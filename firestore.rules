rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && request.auth.token.admin == true;}
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  function validPosition(){return request.resource.data.position is map
   && request.resource.data.position.keys().hasOnly(['x','z'])
   && request.resource.data.position.x is number && request.resource.data.position.z is number
   && request.resource.data.position.x >= -32 && request.resource.data.position.x <= 32
   && request.resource.data.position.z >= -26 && request.resource.data.position.z <= 26;}
  match /users/{uid} {
   allow read: if owner(uid) || admin();
   allow create,update: if owner(uid) && request.resource.data.keys().hasOnly(['displayName','photoURL','updatedAt'])
    && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
    && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048;
   allow delete: if admin();
  }
  match /items/{id} {allow read: if true; allow write: if admin();}
  match /missions/{id} {allow read: if true; allow write: if admin();}
  match /game_settings/{id} {allow read: if true; allow write: if admin();}
  match /player_inventory/{uid} {allow read: if owner(uid) || admin(); allow write: if false;}
  match /player_progress/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['position','updatedAt']) && validPosition();
   allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['position','updatedAt']) && validPosition();
   allow delete: if false;
  }
  match /leaderboard/{uid} {allow read: if signedIn(); allow write: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}
